<div class="su-homepage-search su-site-search search-results search-results-page" role="search">
  <form class="su-homepage-search__form" action="/search" method="get">
    <h2 class="su-homepage-search__label">What would you like to do today?</h2>
    <div class="su-homepage-search_input-wrapper">
      <label for="search-results-key" class="visually-hidden">Search this site</label>
      <input type="text" id="search-results-key" name="key" class="su-homepage-search__input" placeholder="Search" maxlength="128">
      <button type="submit" name="search" class="su-homepage-search__submit">
        <span class="sr-only">Submit Search</span>
        {{ source(directory ~ '/src/assets/svg/icon_search_white.svg') }}
      </button>
    </div>
  </form>

  <ul class="su-homepage-search__actions">
    <li>
      <a href="/waste-tag/" class="su-homepage-search__action-btn">
        <span><i class="fa-solid fa-tag"></i></span>
        <span>Create a waste tag</span>
      </a>
    </li>
    <li>
      <a href="https://ctprdweb.stanford.edu/" class="su-homepage-search__action-btn">
        <span><i class="fa-solid fa-flask"></i></span>
        <span>Update chemical inventory</span>
      </a>
    </li>
    <li>
      <a href="/topic/ergonomics.html" class="su-homepage-search__action-btn">
        <span><i class="fa-solid fa-chair"></i></span>
        <span>Find ergonomic resources</span>
      </a>
    </li>
  </ul>
</div>
